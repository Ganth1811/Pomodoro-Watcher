        "z": "1e0103913cca0c1d",
        "name": "function 1",
        "func": "const d = msg.payload;\nconst states = [\"NGHI (IDLE)\", \"MAN HINH CHAO\", \"CAI DAT\", \"CAI DAT\", \"CAI DAT\", \"DANG HOC\", \"TAM DUNG\"];\n\nreturn [\n    { payload: d.temp },                                // Out 1 -> ui-gauge (Nhiệt độ °C) & ui-chart\n    { payload: d.hum },                                 // Out 2 -> ui-gauge (Độ ẩm %)\n    { payload: Math.round((d.noise / 4095) * 100) },    // Out 3 -> ui-gauge (Độ ồn %) & ui-chart\n    { payload: d.gas },                                 // Out 4 -> ui-gauge (Khí Gas / Báo cháy)\n    { payload: states[d.state] || \"UNKNOWN\" },          // Out 5 -> ui-text (Trạng thái hiện tại)\n    { payload: `Rời bàn: ${d.leaves} lần | Ồn: ${d.noise_alerts} lần | Đèn: ${Math.round(d.lamp / 255 * 100)}%` } // Out 6 -> ui-text\n];",
